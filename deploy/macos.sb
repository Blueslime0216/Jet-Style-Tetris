(version 1)
(deny default)
(allow process-fork)
(allow process-info*)
(allow file-map-executable)
(allow ipc-posix*)
(allow process-exec (literal (param "NODE")) (literal (param "ENGINE")))
(allow signal (target self) (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
(allow file-read* (literal "/") (literal (param "APP_ROOT")) (subpath "/opt/homebrew/etc/openssl@3") (subpath "/opt/homebrew/etc/ca-certificates"))
(allow file-read*
  (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share")
  (subpath "/private/var/db/dyld") (subpath "/private/etc")
  (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/opt")
  (literal "/dev/urandom") (literal "/dev/random") (literal "/dev/null")
  (subpath (string-append (param "APP_ROOT") "/src"))
  (subpath (string-append (param "APP_ROOT") "/web"))
  (subpath (string-append (param "APP_ROOT") "/config"))
  (subpath (string-append (param "APP_ROOT") "/knowledge"))
  (subpath (string-append (param "APP_ROOT") "/node_modules"))
  (subpath (string-append (param "APP_ROOT") "/var"))
  (literal (string-append (param "APP_ROOT") "/package.json"))
  (literal (string-append (param "APP_ROOT") "/.env"))
  (literal (param "ENGINE")) (literal (param "NODE")))
(allow file-write* (subpath (string-append (param "APP_ROOT") "/var")) (literal "/dev/null"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "*:443") (remote ip "*:53") (remote unix-socket))
