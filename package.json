{
  "name": "style-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:engine": "node scripts/cargo.mjs build --release",
    "start": "node src/server/index.js",
    "test": "node --test tests/*.test.js",
    "test:engine": "node scripts/cargo.mjs test",
    "check": "node --check src/server/index.js && node --check web/app.js",
    "build": "npm run build:engine",
    "install:service": "node scripts/install-launch-agent.mjs",
    "tbp": "node src/adapters/tbp-cli.js"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.6.2",
    "tetris-fumen": "1.1.3"
  }
}
