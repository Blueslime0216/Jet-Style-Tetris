{
  "schemaVersion": 1,
  "knowledgeVersion": "2026-09-18.2",
  "researchedAt": "2026-09-18",
  "runtimePolicy": "offline-static-read-only; executable requires target-engine validation",
  "terms": [
    {
      "id": "pc",
      "name": "Perfect Clear (PC)",
      "definition": "A line clear leaves no occupied cells on the board. PC opportunity must be proven by a complete reachable continuation.",
      "sourceIds": [
        "four-pco",
        "solution-finder"
      ],
      "status": "documented"
    },
    {
      "id": "tss",
      "name": "T-Spin Single (TSS)",
      "definition": "A recognized T-spin clears one line. A mini single must remain distinguishable from a full single in rules and constraints.",
      "sourceIds": [
        "basic-tspins"
      ],
      "status": "documented"
    },
    {
      "id": "tsd",
      "name": "T-Spin Double (TSD)",
      "definition": "A recognized T-spin clears two lines. Geometry alone does not prove the last action was a qualifying rotation.",
      "sourceIds": [
        "basic-tspins"
      ],
      "status": "documented"
    },
    {
      "id": "tst",
      "name": "T-Spin Triple (TST)",
      "definition": "A recognized T-spin clears three lines; requires the appropriate reachable kick path.",
      "sourceIds": [
        "four-infinite-tst"
      ],
      "status": "documented"
    },
    {
      "id": "opener",
      "name": "Opener",
      "definition": "A planned early-game structure whose availability depends on queue, hold, rules and interference.",
      "sourceIds": [
        "four-tki",
        "four-pco"
      ],
      "status": "documented"
    },
    {
      "id": "midgame",
      "name": "Midgame setup",
      "definition": "A technique fitted to the current terrain, not necessarily a memorized empty-board opening.",
      "sourceIds": [
        "four-stsd"
      ],
      "status": "documented"
    },
    {
      "id": "donation",
      "name": "Donation",
      "definition": "Build and clear a spin above an underlying structure while preserving useful lower terrain.",
      "sourceIds": [
        "four-kaidan",
        "four-stmb"
      ],
      "status": "documented"
    },
    {
      "id": "b2b",
      "name": "Back-to-back (B2B)",
      "definition": "A chain of ruleset-defined difficult clears. Which clears preserve or break it and its attack bonus are adapter data.",
      "sourceIds": [
        "tetrio-developer",
        "mechanical-heart-guide"
      ],
      "status": "documented"
    },
    {
      "id": "all-spin",
      "name": "All-spin",
      "definition": "Rules recognize spins by non-T pieces; detection, mini handling and B2B rewards vary. It is not implied by SRS rotation.",
      "sourceIds": [
        "mechanical-heart-guide",
        "tetrio-developer"
      ],
      "status": "documented"
    },
    {
      "id": "srs",
      "name": "SRS",
      "definition": "Rotation orientations and kick rules. Use the actual engine table; 180-degree kicks are an extra versioned capability.",
      "sourceIds": [
        "tetrio-developer",
        "fumen-decoder"
      ],
      "status": "documented"
    },
    {
      "id": "7-bag",
      "name": "7-bag",
      "definition": "A bag contains one of each I/O/T/J/L/S/Z; permutations and held leftovers affect opener and loop compatibility.",
      "sourceIds": [
        "four-dpc",
        "four-tki"
      ],
      "status": "documented"
    },
    {
      "id": "hold",
      "name": "Hold",
      "definition": "An engine-validated piece swap/store operation. Queue plans must track held piece and whether hold is available.",
      "sourceIds": [
        "four-pco"
      ],
      "status": "documented"
    },
    {
      "id": "fumen",
      "name": "Fumen",
      "definition": "Encoded diagram pages containing field, optional operation and flags. Pages can contain edited fields or alternatives; a sequence of pages is not necessarily a replay.",
      "sourceIds": [
        "fumen-decoder",
        "hachispin-original"
      ],
      "status": "documented"
    },
    {
      "id": "downstack",
      "name": "Downstack",
      "definition": "Clear or uncover lower terrain, including garbage, while controlling the amount of new stack above it.",
      "sourceIds": [
        "stacking-guide"
      ],
      "status": "documented"
    },
    {
      "id": "hole",
      "name": "Hole",
      "definition": "For this project: an empty cell below an occupied cell in the same column; geometric feature, not proof of inaccessibility.",
      "sourceIds": [
        "stacking-guide"
      ],
      "status": "documented"
    },
    {
      "id": "overhang",
      "name": "Overhang",
      "definition": "Occupied cells above a cavity; useful for spin construction but can obstruct cleanup.",
      "sourceIds": [
        "four-infinite-tst",
        "four-stmb"
      ],
      "status": "documented"
    },
    {
      "id": "stacking-6-3",
      "name": "6-3 Stacking",
      "definition": "Six columns of stack on the left, a one-column interior well at x=6 (zero-based), and three columns on the right. Mirroring gives a 3-6 layout with well x=3. Distinct from 9-0 and LST.",
      "sourceIds": [
        "tec-stacking-guide",
        "four-mko"
      ],
      "status": "documented"
    },
    {
      "id": "four-wide",
      "name": "4-wide",
      "definition": "A four-column-wide combo well with residual blocks; distinct from the one-column well in 6-3 or 9-0 stacking.",
      "sourceIds": [
        "four-dt-cannon",
        "stacking-guide"
      ],
      "status": "documented"
    },
    {
      "id": "loop",
      "name": "Loop",
      "definition": "A route that can return to a usable structural or bag state. The label alone does not guarantee indefinite queue coverage.",
      "sourceIds": [
        "four-dpc",
        "four-infinite-tst"
      ],
      "status": "documented"
    },
    {
      "id": "washing-machine",
      "name": "Washing Machine",
      "definition": "A visual repeated-rotation stunt, not a standardized attack award. Geometry and lock/rotation rules must be validated.",
      "sourceIds": [
        "washing-machine-demo"
      ],
      "status": "documented"
    },
    {
      "id": "among-us",
      "name": "Among Us",
      "definition": "Crewmate-shaped block art/meme build; no standardized attack award.",
      "sourceIds": [
        "among-us-demo"
      ],
      "status": "documented"
    },
    {
      "id": "mechanical-heart",
      "name": "Mechanical Hearts",
      "definition": "All-spin loop family; requires non-T spin rewards for its intended B2B strategy.",
      "sourceIds": [
        "mechanical-heart-guide"
      ],
      "status": "documented"
    },
    {
      "id": "stacking-9-0",
      "name": "9-0 Stacking / Side well",
      "definition": "Nine columns of stack left of a one-column right-edge well (x=9). Mirroring gives a left-edge well (x=0), strictly the 0-9 layout.",
      "sourceIds": [
        "tec-stacking-guide"
      ],
      "status": "documented"
    }
  ],
